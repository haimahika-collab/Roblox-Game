      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">DeliveryTasks</string>
          <string name="Source"><![CDATA[local Tasks = {}

Tasks.Names = { "Mailbox", "Signature", "Photo" }

function Tasks.instruction(kind, stage)
	if kind == "Mailbox" then return "Place the parcel in the roadside mailbox." end
	if kind == "Signature" then
		return if stage == "Waiting" then "Wait three seconds, then collect the signature at the door." else "Ring at the door, then wait for the customer's signature."
	end
	return if stage == "Photo" then "Go to the photo marker, face the front door, and take proof of delivery." else "Leave the parcel at the door, then photograph it from the street."
end

-- No client can choose its task, skip a stage, or supply the signature timer.
function Tasks.interact(kind, stage, action, now, started, facingDoor)
	if kind == "Mailbox" then return if action == "Mailbox" then "Complete" else "WrongTarget" end
	if kind == "Signature" then
		if action ~= "Door" then return "WrongTarget" end
		if stage == "Start" then return "Wait" end
		if stage ~= "Waiting" then return "WrongTarget" end
		return if now - started >= 3 then "Complete" else "Waiting"
	end
	if kind == "Photo" then
		if stage == "Start" then return if action == "Door" then "Place" else "PlaceFirst" end
		if stage ~= "Photo" then return "WrongTarget" end
		if action ~= "Photo" then return "NeedPhoto" end
		return if facingDoor then "Complete" else "FaceDoor"
	end
	return "WrongTarget"
end

return Tasks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[-- Pure game rules shared with the command-line regression tests.
local Rules = {}

function Rules.delivery(index, route, carrying, kind, flashlight, sprinting, noisyUntil, now)
	if index < route then return "RepeatedBell" end
	if index > route then return "WrongAddress" end
	if not carrying then return "NoParcel" end
	if kind == "Dark" and flashlight then return "Light" end
	if kind == "Quiet" and (sprinting or now < noisyUntil) then return "Noise" end
	return "Deliver"
end

function Rules.detectable(z, distance, radius, sprinting, flashlight, angry)
	if z >= -12 then return false end
	local range = radius + (if sprinting then 55 else 0) + (if flashlight then 25 else 0)
	return angry or distance < range
end

return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">LastDelivery</string>
      </Properties>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.LastDelivery.Config)
local Rules = require(ReplicatedStorage.LastDelivery.Rules)
local Tasks = require(ReplicatedStorage.LastDelivery.DeliveryTasks)

Players.RespawnTime = 5
Lighting.ClockTime = 0
Lighting.Brightness = 1
Lighting.Ambient = Color3.fromRGB(30, 34, 50)
Lighting.OutdoorAmbient = Color3.fromRGB(18, 22, 35)
Lighting.FogColor = Color3.fromRGB(20, 24, 35)
Lighting.FogStart = 35
Lighting.FogEnd = 230

local remote = Instance.new("RemoteEvent")
remote.Name = "GameEvent"
remote.Parent = ReplicatedStorage.LastDelivery
local world = Instance.new("Folder")
world.Name = "LastDeliveryWorld"
world.Parent = workspace

local function part(name, size, position, color, parent)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.Position = position
	object.Anchored = true
	object.Color = color
	object.Material = Enum.Material.SmoothPlastic
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent or world
	return object
end

local function label(target, text)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 60)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 400
	gui.Parent = target
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 1)
	title.BackgroundTransparency = 1
	title.Text = text
	title.TextColor3 = Color3.fromRGB(255, 220, 160)
	title.TextStrokeTransparency = 0.3
	title.Font = Enum.Font.GothamBold
	title.TextSize = 18
	title.Parent = gui
end

local function prompt(target, action, description, callback)
	local interaction = Instance.new("ProximityPrompt")
	interaction.ActionText = action
	interaction.ObjectText = description
	interaction.HoldDuration = 0
	interaction.ClickablePrompt = true
	interaction.MaxActivationDistance = 12
	interaction.RequiresLineOfSight = false
	interaction.Parent = target
	interaction.Triggered:Connect(function(player)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 and (root.Position - target.Position).Magnitude <= 14 then
			callback(player)
		end
	end)
	return interaction
end

part("Ground", Vector3.new(360, 2, 430), Vector3.new(0, -1, -130), Color3.fromRGB(25, 38, 30))
part("Road", Vector3.new(44, 0.2, 370), Vector3.new(0, 0.1, -130), Color3.fromRGB(31, 32, 37))
for z = 20, -300, -20 do
	part("RoadStripe", Vector3.new(0.6, 0.1, 9), Vector3.new(0, 0.25, z), Color3.fromRGB(170, 150, 85))
end
for _, x in ipairs({ -25, 25 }) do
	part("Sidewalk", Vector3.new(6, 0.4, 370), Vector3.new(x, 0.2, -130), Color3.fromRGB(75, 76, 81))
end
for z = 0, -280, -56 do
	local post = part("Streetlight", Vector3.new(0.8, 19, 0.8), Vector3.new(27, 9.5, z), Color3.fromRGB(45, 47, 50))
	local lamp = part("Lamp", Vector3.new(4, 0.4, 3), post.Position + Vector3.new(-1.6, 9.5, 0), Color3.fromRGB(245, 207, 140))
	lamp.Material = Enum.Material.Neon
	local light = Instance.new("PointLight")
	light.Color = lamp.Color
	light.Range = 33
	light.Brightness = 1.5
	light.Parent = lamp
end

local spawn = Instance.new("SpawnLocation")
spawn.Name = "VanSpawn"
spawn.Size = Vector3.new(8, 1, 8)
spawn.Position = Vector3.new(0, 1, 35)
spawn.Transparency = 1
spawn.CanCollide = false
spawn.Anchored = true
spawn.Neutral = true
spawn.Parent = world

-- Park off the player's straight route into the street, rather than blocking it.
local van = part("DeliveryVan", Vector3.new(12, 9, 20), Vector3.new(-14, 5, 15), Color3.fromRGB(166, 136, 85))
part("Windshield", Vector3.new(10, 3, 0.3), Vector3.new(-14, 7, 4.8), Color3.fromRGB(35, 58, 70))
for _, x in ipairs({ -6, 6 }) do
	for _, z in ipairs({ 9, 21 }) do
		part("Wheel", Vector3.new(1, 4, 4), Vector3.new(x - 14, 2, z), Color3.fromRGB(16, 16, 18))
	end
end
label(van, "LAST DELIVERY • DISPATCH")
part("ParcelHatch", Vector3.new(6, 3, 0.5), Vector3.new(-14, 4, 25.4), Color3.fromRGB(108, 84, 48))
local hatch = part("ParcelPickup", Vector3.new(3, 2, 2.5), Vector3.new(-10, 2, 31), Color3.fromRGB(189, 139, 76))
label(hatch, "COLLECT PARCEL HERE\nPress E / tap prompt")
local exit = part("DriverDoor", Vector3.new(0.5, 5, 6), Vector3.new(-20.4, 5, 9), Color3.fromRGB(120, 96, 60))

local function numberPlate(target, number, face)
	local surface = Instance.new("SurfaceGui")
	surface.Name = "AddressPlate"
	surface.Face = face
	surface.CanvasSize = Vector2.new(300, 180)
	surface.LightInfluence = 0
	surface.Parent = target
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundColor3 = Color3.fromRGB(20, 25, 32)
	text.TextColor3 = Color3.fromRGB(255, 226, 156)
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true
	text.Text = number
	text.Parent = surface
end

local porches = {}
for index, house in ipairs(Config.Houses) do
	local p = house.Position
	local side = if p.X < 0 then 1 else -1
	part("House" .. house.Number, Vector3.new(32, 22, 34), p + Vector3.new(0, 11, 0), Color3.fromRGB(57 + index * 9, 57, 65))
	part("Roof", Vector3.new(36, 3, 38), p + Vector3.new(0, 23, 0), Color3.fromRGB(29, 28, 33))
	local door = part("Door" .. house.Number, Vector3.new(0.5, 9, 5), p + Vector3.new(side * 16.4, 4.5, 0), Color3.fromRGB(55, 35, 31))
	local porch = part("Porch" .. house.Number, Vector3.new(12, 0.5, 12), p + Vector3.new(side * 22, 0.3, 0), Color3.fromRGB(91, 83, 75))
	part("Walkway", Vector3.new(22, 0.2, 6), Vector3.new(side * -37, 0.2, p.Z), Color3.fromRGB(72, 72, 76))
	label(door, "HOUSE " .. house.Number)
	-- Large self-lit address plates on both sides of a roadside sign.
	local signX = if p.X < 0 then -31 else 31
	part("AddressPost" .. house.Number, Vector3.new(0.5, 5, 0.5), Vector3.new(signX, 2.5, p.Z + 9), Color3.fromRGB(95, 87, 73))
	local sign = part("AddressSign" .. house.Number, Vector3.new(7, 4, 0.4), Vector3.new(signX, 5, p.Z + 9), Color3.fromRGB(25, 30, 38))
	numberPlate(sign, house.Number, Enum.NormalId.Front)
	numberPlate(sign, house.Number, Enum.NormalId.Back)
	local plate = part("DoorNumber" .. house.Number, Vector3.new(0.3, 2, 3), p + Vector3.new(side * 16.8, 10.5, 0), Color3.fromRGB(25, 30, 38))
	numberPlate(plate, house.Number, if side == 1 then Enum.NormalId.Right else Enum.NormalId.Left)
	local mailbox = part("Mailbox" .. house.Number, Vector3.new(2, 1.5, 3), Vector3.new(signX, 3, p.Z - 8), Color3.fromRGB(117, 133, 144))
	part("MailboxPost", Vector3.new(0.5, 3, 0.5), mailbox.Position - Vector3.new(0, 1.5, 0), Color3.fromRGB(62, 62, 66))
	label(mailbox, "MAILBOX " .. house.Number)
	local photo = part("Photo" .. house.Number, Vector3.new(4, 0.15, 4), Vector3.new(signX, 0.5, p.Z), Color3.fromRGB(184, 155, 72))
	photo.CanCollide = false
	local window = part("Window" .. house.Number, Vector3.new(0.4, 5, 6), p + Vector3.new(side * 16.5, 13, 9), Color3.fromRGB(38, 48, 60))
	local watcher = part("Watcher" .. house.Number, Vector3.new(0.3, 4, 1.5), window.Position + Vector3.new(side * 0.3, 0, 0), Color3.fromRGB(3, 3, 5))
	watcher.CanCollide = false
	watcher.Transparency = 1
	porches[index] = { Door = door, Porch = porch, Mailbox = mailbox, Photo = photo, Window = window, Watcher = watcher }
end

-- A readable silhouette that needs no uploaded models or paid assets.
local creature = Instance.new("Model")
creature.Name = "TheFollower"
creature.Parent = world
local torso = part("Body", Vector3.new(3, 7, 2), Vector3.new(0, 5, -300), Color3.fromRGB(8, 8, 12), creature)
part("Head", Vector3.new(2.4, 2.5, 2), torso.Position + Vector3.new(0, 4.3, 0), Color3.fromRGB(19, 17, 20), creature)
for _, x in ipairs({ -2, 2 }) do
	part("Arm", Vector3.new(0.8, 8, 0.8), torso.Position + Vector3.new(x, -0.5, 0), Color3.fromRGB(9, 9, 12), creature)
end
for _, x in ipairs({ -0.6, 0.6 }) do
	local eye = part("Eye", Vector3.new(0.3, 0.25, 0.2), torso.Position + Vector3.new(x, 4.5, -1.1), Color3.fromRGB(255, 75, 60), creature)
	eye.Material = Enum.Material.Neon
end
for _, object in ipairs(creature:GetChildren()) do
	if object:IsA("BasePart") then object.CanCollide = false end
end
creature.PrimaryPart = torso

local phase = "Waiting"
local route = 1
local delivered = 0
local deadline = 0
local result = ""
local carrier = nil
local angerUntil = 0
local state = {}
local lastAttack = {}
local monsterPosition = Vector3.new(0, 5, -300)
local random = Random.new()
local taskKinds = table.clone(Tasks.Names)
local taskStage = "Start"
local taskStarted = 0
local placedParcel = nil
local encounterSeen = {}
local roundId = 0
local lastRadio = nil

local function radio(speaker, message)
	lastRadio = { Speaker = speaker, Message = message }
	remote:FireAllClients("Radio", lastRadio)
end

local function clearTask()
	taskStage = "Start"
	taskStarted = 0
	if placedParcel then placedParcel:Destroy(); placedParcel = nil end
end

local function targetName(house)
	if phase == "Escape" then return "DriverDoor" end
	if phase ~= "Delivery" or not house then return "" end
	if not carrier then return "ParcelPickup" end
	local kind = taskKinds[route]
	if kind == "Mailbox" then return "Mailbox" .. house.Number end
	if kind == "Photo" and taskStage == "Photo" then return "Photo" .. house.Number end
	return "Door" .. house.Number
end

local function send(player, message)
	remote:FireClient(player, "Notice", message)
end

local function broadcast()
	local house = Config.Houses[route]
	for index, porch in ipairs(porches) do
		local actions = porch.Actions
		if actions then
			local active = phase == "Delivery" and index == route and carrier ~= nil
			local kind = taskKinds[route]
			actions.Mailbox.Enabled = active and kind == "Mailbox"
			actions.Photo.Enabled = active and kind == "Photo" and taskStage == "Photo"
			actions.Door.Enabled = phase == "Delivery" and (index < route or (active and (kind == "Signature" or (kind == "Photo" and taskStage == "Start"))))
			actions.Door.ActionText = if index < route then "Ring again (unsafe)" elseif kind == "Signature" then (if taskStage == "Waiting" then "Collect signature" else "Request signature") else "Place parcel"
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		remote:FireClient(player, "State", {
			Phase = phase, Delivered = delivered, Total = #Config.Houses,
			Remaining = math.max(0, math.ceil(deadline - workspace:GetServerTimeNow())),
			House = house and house.Number or "", Rule = house and house.Rule or "",
			Carrier = carrier and carrier.DisplayName or "", IsCarrier = carrier == player,
			Result = result,
			Target = targetName(house),
			Task = house and Tasks.instruction(taskKinds[route], taskStage) or "",
		})
	end
end

local function removeParcel(player)
	if player and player.Character then
		local parcel = player.Character:FindFirstChild("DeliveryParcel")
		if parcel then parcel:Destroy() end
	end
end

local function dropParcel(player)
	if carrier == player then
		removeParcel(player)
		carrier = nil
		clearTask()
		broadcast()
	end
end

local function finish(won)
	phase = "Intermission"
	result = if won then "ROUTE COMPLETE — You made it out. But who signed the last receipt?" else "SHIFT LOST — The neighborhood keeps its packages."
	removeParcel(carrier)
	carrier = nil
	clearTask()
	deadline = workspace:GetServerTimeNow() + Config.IntermissionSeconds
	broadcast()
end

local function anger(player, reason)
	angerUntil = workspace:GetServerTimeNow() + 12
	remote:FireClient(player, "Scare", reason)
	-- The monster approaches by road; it never teleports onto a player.
end

local pickupPrompt = prompt(hatch, "Collect parcel", "PARCEL PICKUP • next to the van", function(player)
	if phase ~= "Delivery" then send(player, "Complete your route, then use the driver door to escape."); return end
	if carrier then send(player, carrier.DisplayName .. " already has the parcel."); return end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	carrier = player
	local parcel = Instance.new("Part")
	parcel.Name = "DeliveryParcel"
	parcel.Size = Vector3.new(2.2, 1.6, 1.6)
	parcel.Color = Color3.fromRGB(160, 118, 68)
	parcel.CanCollide = false
	parcel.Massless = true
	parcel.CFrame = root.CFrame * CFrame.new(0, -0.2, -2)
	parcel.Parent = character
	numberPlate(parcel, Config.Houses[route].Number, Enum.NormalId.Front)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = parcel
	weld.Parent = parcel
	send(player, "Parcel collected. Read the instruction before approaching the house.")
	broadcast()
end)

-- Reflect the address on the pickup itself, even before a player collects it.
task.spawn(function()
	while world.Parent do
		local house = Config.Houses[route]
		pickupPrompt.Enabled = phase == "Delivery" and carrier == nil
		if house then
			pickupPrompt.ActionText = "Collect parcel " .. house.Number
			pickupPrompt.ObjectText = "DELIVER TO HOUSE " .. house.Number
		end
		task.wait(0.2)
	end
end)

for index, house in ipairs(Config.Houses) do
	local function interact(player, action)
		if phase ~= "Delivery" then return end
		local data = state[player]
		if not data then return end
		local decision = Rules.delivery(index, route, carrier == player, house.Kind, data.Flashlight, data.Sprinting, data.NoisyUntil, workspace:GetServerTimeNow())
		if decision == "RepeatedBell" then
			if action == "Door" then anger(player, "You rang twice. Something heard you.") else send(player, "This address is already complete.") end
			return
		end
		if decision == "WrongAddress" then send(player, "Wrong address. Follow the dispatch route."); return end
		if decision == "NoParcel" then send(player, "Collect this house's parcel from the van first."); return end
		if decision == "Light" then
			anger(player, "The light woke the tenant. Turn it OFF and try again.")
			return
		end
		if decision == "Noise" then
			anger(player, "Too loud. Walk slowly and let the porch settle.")
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local direction = porches[index].Door.Position - root.Position
		local facing = direction.Magnitude > 0 and root.CFrame.LookVector:Dot(direction.Unit) > 0.4
		local outcome = Tasks.interact(taskKinds[route], taskStage, action, workspace:GetServerTimeNow(), taskStarted, facing)
		if outcome == "Wait" then
			taskStage = "Waiting"
			taskStarted = workspace:GetServerTimeNow()
			radio("TENANT", "One moment. I need to find a pen. Stay by the door.")
			broadcast()
			return
		elseif outcome == "Place" then
			taskStage = "Photo"
			removeParcel(player)
			placedParcel = part("ProofParcel", Vector3.new(2, 1.5, 2), porches[index].Porch.Position + Vector3.new(0, 1, 0), Color3.fromRGB(170, 125, 72))
			numberPlate(placedParcel, house.Number, Enum.NormalId.Front)
			send(player, "Parcel placed. Go to the gold photo marker, face the door, then use Take photo.")
			broadcast()
			return
		elseif outcome ~= "Complete" then
			local messages = {
				WrongTarget = "Check the task: " .. Tasks.instruction(taskKinds[route], taskStage),
				Waiting = "The tenant is still finding a pen. Wait three seconds, then interact again.",
				PlaceFirst = "Leave the parcel at the door before taking a photo.",
				NeedPhoto = "The parcel is down. Take proof from the gold photo marker.",
				FaceDoor = "Turn your CHARACTER toward the front door, then take the photo.",
			}
			send(player, messages[outcome] or "Follow the delivery task.")
			return
		end
		if taskKinds[route] == "Photo" then remote:FireClient(player, "Photo", "Proof of delivery saved for this shift.") end
		removeParcel(player)
		carrier = nil
		clearTask()
		delivered += 1
		route += 1
		if delivered == #Config.Houses then
			phase = "Escape"
			angerUntil = workspace:GetServerTimeNow() + 999
			send(player, "All packages delivered. EVERYONE back to the van!")
			radio("UNKNOWN SIGNAL", "All deliveries received. There is one more passenger in your van.")
		else
			send(player, "Delivered. Return to dispatch for the next parcel.")
			radio("DISPATCH", if delivered == 1 then "Receipt confirmed. If you see anyone in a window, keep moving." else "Last stop. Someone is using our frequency. Trust the written delivery notes.")
		end
		broadcast()
	end
	porches[index].Actions = {
		Door = prompt(porches[index].Door, "Deliver / collect signature", "House " .. house.Number, function(player) interact(player, "Door") end),
		Mailbox = prompt(porches[index].Mailbox, "Deliver to mailbox", "Mailbox " .. house.Number, function(player) interact(player, "Mailbox") end),
		Photo = prompt(porches[index].Photo, "Take photo", "Face the front door • proof of delivery", function(player) interact(player, "Photo") end),
	}
end

prompt(exit, "Finish shift", "Driver door • gather your crew nearby", function(player)
	if phase ~= "Escape" then send(player, "There are still packages to deliver."); return end
	for _, teammate in ipairs(Players:GetPlayers()) do
		local character = teammate.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if humanoid and humanoid.Health > 0 and root and (root.Position - van.Position).Magnitude > 28 then
			send(player, "A living teammate is still outside. Bring everyone back.")
			return
		end
	end
	finish(true)
end)

remote.OnServerEvent:Connect(function(player, action, enabled)
	local data = state[player]
	if not data then return end
	local now = workspace:GetServerTimeNow()
	if action == "Ready" then
		if now - data.LastReady < 1 then return end
		data.LastReady = now
		broadcast()
		if lastRadio then remote:FireClient(player, "Radio", lastRadio) end
		return
	end
	if typeof(enabled) ~= "boolean" then return end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	if action == "Sprint" then
		data.Sprinting = enabled
		humanoid.WalkSpeed = if enabled then 22 else 12
	elseif action == "Flashlight" then
		data.Flashlight = enabled
		local head = character:FindFirstChild("Head")
		local light = head and head:FindFirstChild("DeliveryLight")
		if light then light.Enabled = enabled end
	end
end)

local function characterAdded(player, character)
	dropParcel(player)
	local data = state[player]
	if not data then return end
	data.Sprinting = false
	data.Flashlight = false
	data.NoisyUntil = 0
	local humanoid = character:WaitForChild("Humanoid")
	humanoid.WalkSpeed = 12
	local head = character:WaitForChild("Head")
	local light = Instance.new("SpotLight")
	light.Name = "DeliveryLight"
	light.Angle = 75
	light.Range = 55
	light.Brightness = 3
	light.Enabled = false
	light.Parent = head
	humanoid.Died:Connect(function()
		dropParcel(player)
		send(player, "The follower caught you. Dispatch will recover you in five seconds.")
	end)
	broadcast()
end

local function playerAdded(player)
	if #Players:GetPlayers() > Config.MaxPlayers then player:Kick("This delivery crew is full (4 players)."); return end
	state[player] = { Sprinting = false, Flashlight = false, NoisyUntil = 0, LastReady = 0 }
	player.CharacterAdded:Connect(function(character) characterAdded(player, character) end)
	if player.Character then task.spawn(characterAdded, player, player.Character) end
end
Players.PlayerAdded:Connect(playerAdded)
for _, player in ipairs(Players:GetPlayers()) do playerAdded(player) end
Players.PlayerRemoving:Connect(function(player)
	dropParcel(player)
	state[player] = nil
	lastAttack[player] = nil
end)

local function beginRound()
	roundId += 1
	clearTask()
	taskKinds = table.clone(Tasks.Names)
	for i = #taskKinds, 2, -1 do
		local j = random:NextInteger(1, i)
		taskKinds[i], taskKinds[j] = taskKinds[j], taskKinds[i]
	end
	encounterSeen = {}
	for _, porch in ipairs(porches) do
		porch.Watcher.Transparency = 1
		porch.Window.Color = Color3.fromRGB(38, 48, 60)
		porch.Window.Material = Enum.Material.SmoothPlastic
	end
	for _, object in ipairs(world:GetDescendants()) do
		if object:IsA("PointLight") then object.Brightness = 1.5 end
	end
	route = 1
	delivered = 0
	result = ""
	angerUntil = 0
	monsterPosition = Vector3.new(0, 5, -300)
	lastAttack = {}
	phase = "Delivery"
	deadline = workspace:GetServerTimeNow() + Config.RoundSeconds
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		if character then character:PivotTo(CFrame.lookAt(Vector3.new(0, 5, 35), Vector3.new(0, 5, -70))) end
	end
	broadcast()
	radio("DISPATCH", "Night shift, check in. Three addresses. Read every note. Mailboxes, signatures and photo proof are on your manifest.")
end

local function encounter(index)
	encounterSeen[index] = true
	local generation = roundId
	local porch = porches[index]
	local kind = random:NextInteger(1, 3)
	if kind == 1 then
		porch.Window.Color = Color3.fromRGB(180, 170, 130)
		porch.Window.Material = Enum.Material.Neon
		porch.Watcher.Transparency = 0
		remote:FireAllClients("Encounter", "A silhouette appears in the window. It is watching the parcel.")
		task.delay(4, function()
			if generation ~= roundId then return end
			porch.Watcher.Transparency = 1
			porch.Window.Material = Enum.Material.SmoothPlastic
			porch.Window.Color = Color3.fromRGB(38, 48, 60)
		end)
	elseif kind == 2 then
		remote:FireAllClients("Encounter", "The nearby streetlights go out. Keep moving; they will return.")
		local lights = {}
		for _, object in ipairs(world:GetDescendants()) do
			if object:IsA("PointLight") and (object.Parent.Position - porch.Door.Position).Magnitude < 80 then
				object.Brightness = 0
				table.insert(lights, object)
			end
		end
		task.delay(3, function()
			if generation ~= roundId then return end
			for _, light in ipairs(lights) do light.Brightness = 1.5 end
		end)
	else
		radio("UNKNOWN SIGNAL", "Three knocks from inside your package. Do not open it. We know your name.")
		remote:FireAllClients("Encounter", "KNOCK. KNOCK. KNOCK. Something moves inside the parcel.")
	end
end

local accumulated = 0
RunService.Heartbeat:Connect(function(dt)
	local now = workspace:GetServerTimeNow()
	if phase == "Delivery" or phase == "Escape" then
		local target = nil
		local closest = math.huge
		for player, data in pairs(state) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if root and humanoid and humanoid.Health > 0 then
				if phase == "Delivery" and player == carrier and not encounterSeen[route] and (root.Position - porches[route].Door.Position).Magnitude < 30 then
					encounter(route)
				end
				local moving = humanoid.MoveDirection.Magnitude > 0.1
				if data.Sprinting and moving then data.NoisyUntil = now + 3 end
				-- The well-lit van is a safe zone; house interiors are sealed.
				local distance = (root.Position - monsterPosition).Magnitude
				if Rules.detectable(root.Position.Z, distance, Config.DetectionRadius, data.Sprinting, data.Flashlight, now < angerUntil) and distance < closest then
					closest = distance
					target = player
				end
			end
		end
		local goal = Vector3.new(0, 5, -150 + math.sin(now / 12) * 110)
		if target then
			local root = target.Character.HumanoidRootPart
			goal = Vector3.new(root.Position.X, 5, root.Position.Z)
			if closest < Config.AttackRadius and now - (lastAttack[target] or 0) > 1.5 then
				lastAttack[target] = now
				target.Character.Humanoid:TakeDamage(Config.AttackDamage)
				remote:FireClient(target, "Scare", "DON'T LOOK BACK.")
			end
		end
		local delta = goal - monsterPosition
		local speed = if now < angerUntil then Config.MonsterSprintSpeed else Config.MonsterSpeed
		-- Clamp frame time so a server hitch cannot teleport the follower.
		if delta.Magnitude > 0.1 then
			local nextPosition = monsterPosition + delta.Unit * math.min(delta.Magnitude, speed * math.min(dt, 0.1))
			-- Walk around the sealed buildings using the road-side corridor.
			if math.abs(nextPosition.X) > 47 then nextPosition = Vector3.new(math.clamp(nextPosition.X, -47, 47), 5, nextPosition.Z) end
			monsterPosition = nextPosition
			creature:PivotTo(CFrame.lookAt(monsterPosition, monsterPosition + delta.Unit))
		end
		if now >= deadline then finish(false) end
	elseif #Players:GetPlayers() > 0 and (phase == "Waiting" or now >= deadline) then
		beginRound()
	end
	accumulated += dt
	if accumulated >= 1 then accumulated = 0; broadcast() end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="8">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="9">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">LastDelivery</string>
        </Properties>
        <Item class="LocalScript" referent="11">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("LastDelivery"):WaitForChild("GameEvent")

local gui = Instance.new("ScreenGui")
gui.Name = "LastDeliveryHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Position = UDim2.new(0, 12, 0, 12)
panel.Size = UDim2.new(0.92, 0, 0, 232)
panel.BackgroundColor3 = Color3.fromRGB(12, 15, 22)
panel.BackgroundTransparency = 1
panel.BorderSizePixel = 0
panel.Parent = gui
local constraint = Instance.new("UISizeConstraint")
constraint.MaxSize = Vector2.new(510, 232)
constraint.Parent = panel
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = panel

local function text(parent, y, height, size, color)
	local object = Instance.new("TextLabel")
	object.Position = UDim2.new(0, 14, 0, y)
	object.Size = UDim2.new(1, -28, 0, height)
	object.BackgroundTransparency = 1
	object.Font = Enum.Font.Gotham
	object.TextSize = size
	object.TextColor3 = color or Color3.fromRGB(225, 225, 230)
	object.TextWrapped = true
	object.TextStrokeTransparency = 0.35
	object.TextXAlignment = Enum.TextXAlignment.Left
	object.TextYAlignment = Enum.TextYAlignment.Center
	object.Parent = parent
	return object
end

local title = text(panel, 8, 26, 20, Color3.fromRGB(238, 190, 111))
title.Text = "THE LAST DELIVERY"
title.Font = Enum.Font.GothamBold
local status = text(panel, 37, 24, 15)
local objective = text(panel, 65, 42, 16)
local rule = text(panel, 108, 76, 14, Color3.fromRGB(244, 201, 143))
local controls = text(panel, 188, 38, 12, Color3.fromRGB(170, 180, 195))
controls.Text = "WASD: move • Space: jump • Hold right mouse: look\nE / tap: interact • F: light • Shift: sprint • Van = safe"

-- This marker is local: every player sees their current shared objective.
local marker = Instance.new("BillboardGui")
marker.Name = "ObjectiveMarker"
marker.Size = UDim2.fromOffset(240, 72)
marker.StudsOffsetWorldSpace = Vector3.new(0, 7, 0)
marker.AlwaysOnTop = true
marker.MaxDistance = 500
marker.Enabled = false
marker.Parent = gui
local markerText = Instance.new("TextLabel")
markerText.Size = UDim2.fromScale(1, 1)
markerText.BackgroundColor3 = Color3.fromRGB(15, 23, 30)
markerText.BackgroundTransparency = 0.15
markerText.TextColor3 = Color3.fromRGB(255, 220, 120)
markerText.TextStrokeTransparency = 0.3
markerText.Font = Enum.Font.GothamBold
markerText.TextSize = 18
markerText.Parent = marker
local markerTarget = ""
local markerCaption = ""
local markerElapsed = 0
RunService.Heartbeat:Connect(function(dt)
	markerElapsed += dt
	if markerElapsed < 0.15 then return end
	markerElapsed = 0
	local world = workspace:FindFirstChild("LastDeliveryWorld")
	local target = world and world:FindFirstChild(markerTarget)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	marker.Enabled = target ~= nil and root ~= nil and markerTarget ~= ""
	marker.Adornee = target
	if target and root then
		markerText.Text = string.format("▼ %s\n%d studs away", markerCaption, math.floor((root.Position - target.Position).Magnitude))
	end
end)

local radioText = Instance.new("TextLabel")
radioText.Name = "DispatchRadio"
radioText.AnchorPoint = Vector2.new(0.5, 1)
radioText.Position = UDim2.new(0.5, 0, 1, -22)
radioText.Size = UDim2.new(0.75, 0, 0, 76)
radioText.BackgroundColor3 = Color3.fromRGB(12, 24, 27)
radioText.BackgroundTransparency = 0.2
radioText.TextColor3 = Color3.fromRGB(164, 230, 207)
radioText.Font = Enum.Font.GothamMedium
radioText.TextSize = 15
radioText.TextWrapped = true
radioText.Visible = false
radioText.Parent = gui
local radioQueue = {}
local lastTransmission = nil
local radioPlaying = false
local function playRadio(payload)
	lastTransmission = payload
	if #radioQueue >= 4 then table.remove(radioQueue, 1) end
	table.insert(radioQueue, payload)
	if radioPlaying then return end
	radioPlaying = true
	task.spawn(function()
		while #radioQueue > 0 do
			local transmission = table.remove(radioQueue, 1)
			radioText.TextColor3 = if transmission.Speaker == "UNKNOWN SIGNAL" then Color3.fromRGB(255, 169, 151) else Color3.fromRGB(164, 230, 207)
			radioText.Text = "[RADIO • " .. transmission.Speaker .. "]\n" .. transmission.Message
			radioText.Visible = true
			task.wait(8)
		end
		radioText.Visible = false
		radioPlaying = false
	end)
end
ContextActionService:BindAction("ReplayRadio", function(_, inputState)
	if inputState == Enum.UserInputState.Begin and lastTransmission and not radioPlaying then playRadio(lastTransmission) end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.R, Enum.KeyCode.DPadUp)

local notice = Instance.new("TextLabel")
notice.AnchorPoint = Vector2.new(0.5, 1)
notice.Position = UDim2.new(0.5, 0, 1, -110)
notice.Size = UDim2.new(0.9, 0, 0, 65)
notice.BackgroundColor3 = Color3.fromRGB(16, 19, 27)
notice.BackgroundTransparency = 0.2
notice.Font = Enum.Font.GothamBold
notice.TextColor3 = Color3.fromRGB(255, 228, 190)
notice.TextSize = 18
notice.TextWrapped = true
notice.Visible = false
notice.Parent = gui

local overlay = Instance.new("Frame")
overlay.Size = UDim2.fromScale(1, 1)
overlay.BackgroundColor3 = Color3.fromRGB(150, 10, 15)
overlay.BackgroundTransparency = 1
overlay.BorderSizePixel = 0
overlay.ZIndex = 5
overlay.Parent = gui

local flashlight = false
local sprinting = false
local function refreshControls()
	ContextActionService:SetTitle("DeliveryFlashlight", if flashlight then "Light ON" else "Light OFF")
end

ContextActionService:BindAction("DeliveryFlashlight", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		flashlight = not flashlight
		remote:FireServer("Flashlight", flashlight)
		refreshControls()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
ContextActionService:SetPosition("DeliveryFlashlight", UDim2.new(1, -180, 1, -150))
refreshControls()

ContextActionService:BindAction("DeliverySprint", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		sprinting = true
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		sprinting = false
	else
		return Enum.ContextActionResult.Sink
	end
	remote:FireServer("Sprint", sprinting)
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
ContextActionService:SetTitle("DeliverySprint", "Sprint")
ContextActionService:SetPosition("DeliverySprint", UDim2.new(1, -100, 1, -200))

local noticeVersion = 0
local function showNotice(message)
	noticeVersion += 1
	local version = noticeVersion
	notice.Text = message
	notice.Visible = true
	task.delay(5, function()
		if noticeVersion == version then notice.Visible = false end
	end)
end

remote.OnClientEvent:Connect(function(kind, payload)
	if kind == "State" then
		markerTarget = payload.Target or ""
		markerCaption = if markerTarget == "ParcelPickup" then "COLLECT PARCEL " .. payload.House elseif markerTarget == "DriverDoor" then "ESCAPE • DRIVER DOOR" elseif string.sub(markerTarget, 1, 7) == "Mailbox" then "MAILBOX • " .. payload.House elseif string.sub(markerTarget, 1, 5) == "Photo" then "PHOTO PROOF • " .. payload.House else "DOOR • HOUSE " .. payload.House
		local minutes = math.floor(payload.Remaining / 60)
		local seconds = payload.Remaining % 60
		status.Text = string.format("%d / %d delivered   •   %02d:%02d until dawn", payload.Delivered, payload.Total, minutes, seconds)
		if payload.Phase == "Delivery" then
			if payload.IsCarrier then
				objective.Text = "Parcel collected! Follow the marker to HOUSE " .. payload.House
			elseif payload.Carrier ~= "" then
				objective.Text = "Escort " .. payload.Carrier .. " to house " .. payload.House
			else
				objective.Text = "Follow COLLECT PARCEL " .. payload.House .. " to the box beside the van. Press E or tap."
			end
			rule.Text = "RULE: " .. payload.Rule .. "\nTASK: " .. (payload.Task or "Deliver at the door.")
		elseif payload.Phase == "Escape" then
			objective.Text = "Return to the van. Gather your crew and use the driver door!"
			rule.Text = "Something is running behind you."
		elseif payload.Phase == "Intermission" then
			status.Text = "Next shift in " .. payload.Remaining .. " seconds"
			objective.Text = payload.Result
			rule.Text = "Take a breath. Dispatch has another route."
		end
	elseif kind == "Notice" then
		showNotice(payload)
	elseif kind == "Radio" then
		playRadio(payload)
	elseif kind == "Encounter" then
		showNotice(payload)
	elseif kind == "Photo" then
		showNotice(payload)
		overlay.BackgroundColor3 = Color3.new(1, 1, 1)
		overlay.BackgroundTransparency = 0.65
		TweenService:Create(overlay, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
	elseif kind == "Scare" then
		showNotice(payload)
		overlay.BackgroundColor3 = Color3.fromRGB(150, 10, 15)
		overlay.BackgroundTransparency = 0.55
		TweenService:Create(overlay, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
	end
end)

player.CharacterAdded:Connect(function()
	flashlight = false
	sprinting = false
	refreshControls()
end)
remote:FireServer("Ready")
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="12">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
