local Tasks = require("../src/shared/DeliveryTasks")
local passed = 0
local function check(name, actual, expected)
	assert(actual == expected, name .. ": expected " .. tostring(expected) .. ", got " .. tostring(actual))
	passed += 1
end
check("mailbox completes at mailbox", Tasks.interact("Mailbox", "Start", "Mailbox", 10, 0, false), "Complete")
check("mailbox cannot finish at door", Tasks.interact("Mailbox", "Start", "Door", 10, 0, false), "WrongTarget")
check("mailbox cannot finish with photograph", Tasks.interact("Mailbox", "Start", "Photo", 10, 0, true), "WrongTarget")
check("signature starts a wait", Tasks.interact("Signature", "Start", "Door", 10, 0, true), "Wait")
check("signature cannot skip wait", Tasks.interact("Signature", "Waiting", "Door", 12.99, 10, true), "Waiting")
check("signature completes at exactly three seconds", Tasks.interact("Signature", "Waiting", "Door", 13, 10, true), "Complete")
check("signature may be collected later", Tasks.interact("Signature", "Waiting", "Door", 50, 10, true), "Complete")
check("mailbox cannot substitute for signature", Tasks.interact("Signature", "Waiting", "Mailbox", 50, 10, true), "WrongTarget")
check("unknown signature stage fails closed", Tasks.interact("Signature", "Unknown", "Door", 50, 10, true), "WrongTarget")
check("photo first requires parcel placement", Tasks.interact("Photo", "Start", "Photo", 10, 0, true), "PlaceFirst")
check("photo parcel placed at door", Tasks.interact("Photo", "Start", "Door", 10, 0, false), "Place")
check("second door press cannot complete photo task", Tasks.interact("Photo", "Photo", "Door", 10, 0, true), "NeedPhoto")
check("photo looking away rejected", Tasks.interact("Photo", "Photo", "Photo", 10, 0, false), "FaceDoor")
check("photo facing address completes task", Tasks.interact("Photo", "Photo", "Photo", 10, 0, true), "Complete")
check("invalid photo stage rejected", Tasks.interact("Photo", "Unknown", "Photo", 10, 0, true), "WrongTarget")
check("unknown task rejected", Tasks.interact("Unknown", "Start", "Door", 10, 0, true), "WrongTarget")
-- Full multi-interaction sequences use increasing server time.
check("signature sequence begins", Tasks.interact("Signature", "Start", "Door", 100, 0, false), "Wait")
check("signature sequence early retry", Tasks.interact("Signature", "Waiting", "Door", 101, 100, false), "Waiting")
check("signature sequence finishes", Tasks.interact("Signature", "Waiting", "Door", 103, 100, false), "Complete")
check("photo sequence begins", Tasks.interact("Photo", "Start", "Door", 100, 0, false), "Place")
check("photo sequence finishes", Tasks.interact("Photo", "Photo", "Photo", 105, 0, true), "Complete")
check("respawn reset requires placing parcel again", Tasks.interact("Photo", "Start", "Photo", 110, 0, true), "PlaceFirst")
print(string.format("PASS: %d delivery task checks", passed))
